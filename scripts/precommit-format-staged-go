#!/usr/bin/env bash
set -euo pipefail

formatter="${1:?pass the formatter selected by the root Makefile}"
tmp=""
trap 'if [ -n "$tmp" ]; then rm -f "$tmp"; fi' EXIT

while IFS= read -r file; do
  if [ -z "$file" ]; then
    continue
  fi
  if [ ! -f "$file" ]; then
    printf 'pre-commit: staged Go file is unavailable: %s\n' "$file" >&2
    exit 1
  fi

  tmp=$(mktemp "${file}.gc-precommit-fmt.XXXXXX")
  "$formatter" fmt --stdin <"$file" >"$tmp"

  if cmp -s "$file" "$tmp"; then
    rm -f "$tmp"
    tmp=""
    continue
  fi

  cat "$tmp" >"$file"
  rm -f "$tmp"
  tmp=""
done
